    {"id": "readback-with-pending-runtime-attempt-stays-uncertain", "ack": "lost", "readback": "exact_installed_and_durable", "epoch": "same", "pending_runtime_attempt": true, "expected": {"application": "uncertain", "retain": ["registration-a", "registration-b"]}},
    {"id": "uncertain-replacement-retains-versions", "ack": "lost", "readback": "previous_route", "epoch": "same", "expected": {"application": "uncertain", "conflicting_write_http_status": 409, "retain": ["registration-a", "registration-b"]}},
    {"id": "rotation-preserves-established-tcp", "previous_registration_revision": "registration-a", "confirmed_registration_revision": "registration-b", "expected": {"established_tcp": "registration-a", "new_tcp": "registration-b"}},
    {"id": "legacy-policy-write-rejects-protected-box", "operation": "legacy_replace", "binding": "pending", "expected": {"outcome": "refused", "mutation": false}},
    {"id": "legacy-recovery-refuses-before-destroy", "operation": "legacy_recover", "binding": "unresolved", "expected": {"outcome": "refused", "destroy": false, "retain_evidence": true}}
