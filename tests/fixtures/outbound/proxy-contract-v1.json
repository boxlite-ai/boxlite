    {"id": "reject-wrong-proxy-tls-identity", "proxy_url": "https://proxy.example.com", "tls_peer_name": "wrong.example.com", "expected": {"diagnostic": "proxy_handshake_failed", "direct_dials": 0}},
    {"id": "unreachable-proxy-no-direct-fallback", "proxy_url": "https://proxy.example.com", "peer_behavior": "unreachable", "expected": {"diagnostic": "proxy_unreachable", "direct_dials": 0}},
    {"id": "refuse-business-loopback-before-proxy", "hostname": "packages.example.com", "connection_ip": "127.0.0.1", "expected": {"proxy_requests": 0, "direct_dials": 0}},
    {"id": "limit-setup-time", "setup_budget_ms": 30000, "peer_behavior": "stall", "expected": {"diagnostic": "proxy_timeout", "direct_dials": 0}},
    {"id": "share-approved-target-across-tcp-paths", "paths": ["ordinary", "inspected", "secrets_mitm"], "expected": {"target": "approved_literal_and_port", "retain_origin_hostname": true}}
