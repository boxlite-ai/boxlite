    {"id": "tls-connect-without-auth", "proxy_url": "https://proxy.example.com", "expected": {"connector": "tls_connect", "port": 443, "auth": "none", "verify_proxy_name": true}},
    {"id": "tls-connect-with-basic-auth", "proxy_url": "https://proxy.example.com", "credential": {"username": "fixture-user", "password": "fixture-password"}, "expected": {"connector": "tls_connect", "port": 443, "auth": "basic", "verify_proxy_name": true}},
