    {"id": "matching-policy-ack-wrong-proxy-route", "ack_policy_revision": "policy-b", "expected_registration_revision": "registration-b", "observed_registration_revision": "registration-a", "expected": {"application": "uncertain", "retain": ["registration-a", "registration-b"]}},
    {
      "id": "matching-policy-and-route-ack-wrong-epoch",
      "candidate": {"policy_revision": "policy-b", "registration_revision": "registration-b", "runtime_epoch": "epoch-current"},
