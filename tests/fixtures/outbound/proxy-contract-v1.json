    {
      "id": "refuse-unbind-without-runner-route-evidence",
      "operation": "replace",
      "current_proxy": "build-egress",
      "input": {"mode": "enabled", "proxy": null},
      "runner": "http_only_v0",
      "expected": {"route": "build-egress", "reserve": false, "dispatch": false, "release_references": false}
    },
    {"id": "retain-binding-while-disabled", "operation": "replace", "input": {"mode": "disabled", "proxy": "build-egress"}, "expected": {"route": "build-egress", "new_egress": "blocked"}},
    {"id": "http-only-runner-rejects-credential-free-binding", "operation": "create", "input": {"mode": "enabled", "proxy": "build-egress"}, "runner": "http_only_v0", "credential_configured": false, "expected": {"dispatch": false, "diagnostic": "runner_proxy_tls_unsupported"}},
    {"id": "v2-runner-rejects-bound-restart", "operation": "restart", "current_proxy": "build-egress", "runner": "v2", "expected": {"dispatch": false, "diagnostic": "runner_proxy_unsupported"}},
    {"id": "legacy-unbound-replacement-stays-supported", "operation": "replace", "runner": "legacy", "input": {"mode": "enabled"}, "expected": "unbound"}
