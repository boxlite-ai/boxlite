{
  "contract_version": 1,
  "registration_cases": [
    {"id": "create-in-own-organization", "operation": "create", "proxy_url": "https://proxy.example.com", "authorized": true, "expected": "registration_created"},
    {"id": "forbid-registry-write-without-permission", "operation": "patch", "authorized": false, "expected": "permission_denied"},
    {"id": "reject-url-userinfo", "operation": "create", "proxy_url": "https://fixture-user@proxy.example.com", "expected": "invalid_argument"},
    {"id": "reject-url-scheme", "operation": "create", "proxy_url": "socks4://proxy.example.com", "expected": "invalid_argument"},
    {"id": "reject-url-path-query-and-fragment", "operation": "create", "invalid_urls": ["https://proxy.example.com/path", "https://proxy.example.com/?option=value", "https://proxy.example.com/#fragment"], "expected": "invalid_argument"},
    {"id": "reject-invalid-proxy-port", "operation": "create", "proxy_url": "https://proxy.example.com:65536", "expected": "invalid_argument"},
    {"id": "preserve-omitted-credential", "operation": "patch", "credential_configured": true, "input": {}, "expected": "preserve_credential"},
    {"id": "clear-null-credential", "operation": "patch", "credential_configured": true, "input": {"credential": null}, "expected": "clear_credential"},
    {"id": "require-credential-choice-on-authority-change", "operation": "patch", "credential_configured": true, "input": {"url": "https://replacement.example.com"}, "expected": "invalid_argument"},
    {"id": "redact-credential-readback", "operation": "read", "credential_configured": true, "expected": {"credential_configured": true, "plaintext": false, "ciphertext": false}},
    {"id": "block-registration-delete-while-referenced", "operation": "delete", "references": ["committed", "pending"], "expected": {"http_status": 409, "retire": false}}
  ],
  "binding_cases": [
    {"id": "create-omitted-is-unbound", "operation": "create", "input": {"mode": "enabled"}, "expected": "unbound"},
    {"id": "create-null-is-unbound", "operation": "create", "input": {"mode": "enabled", "proxy": null}, "expected": "unbound"},
    {"id": "eligible-create-binds-fresh-box", "operation": "create", "input": {"mode": "enabled", "proxy": "build-egress"}, "runner": "enrolled_https_v0", "expected": {"route": "build-egress", "claim_warm_box": false}},
    {"id": "unknown-registration", "operation": "create", "input": {"mode": "enabled", "proxy": "missing"}, "expected": {"http_status": 404, "dispatch": false}},
    {"id": "cross-organization-registration", "operation": "create", "input": {"mode": "enabled", "proxy": "other-organization"}, "expected": {"http_status": 404, "dispatch": false}},
    {"id": "reject-omission-on-bound-replacement", "operation": "replace", "current_proxy": "build-egress", "input": {"mode": "disabled"}, "expected": {"outcome": "incomplete_replacement", "mutation": false}},
