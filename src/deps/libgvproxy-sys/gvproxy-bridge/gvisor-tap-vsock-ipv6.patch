+func (e *Switch) acceptsIPv6(eth header.Ethernet, ip header.IPv6) bool {
+	if !ip.IsValid(len(ip)) || ip.TransportProtocol() != header.ICMPv6ProtocolNumber ||
+		ip.PayloadLength() < header.ICMPv6MinimumSize {
+		return false
+	}
+	icmp := header.ICMPv6(ip.Payload())
+	switch icmp.Type() {
+	case header.ICMPv6NeighborSolicit, header.ICMPv6NeighborAdvert, header.ICMPv6EchoRequest, header.ICMPv6EchoReply:
+	default:
+		return false
+	}
+
+	source, destination := ip.SourceAddress(), ip.DestinationAddress()
+	if source == header.IPv6Any {
+		if icmp.Type() != header.ICMPv6NeighborSolicit || len(icmp) < header.ICMPv6NeighborSolicitMinimumSize {
+			return false
+		}
+		target := header.NDPNeighborSolicit(icmp.MessageBody()).TargetAddress()
+		for _, gateway := range e.ipv6Addresses {
+			if target == gateway.address && destination == gateway.solicitedNode {
+				return eth.DestinationAddress() == header.EthernetAddressFromMulticastIPv6Address(destination)
+			}
+		}
+		return false
+	}
+
+	var onLink, local, solicited bool
+	for _, gateway := range e.ipv6Addresses {
+		onLink = onLink || gateway.prefix.Contains(source)
+		local = local || destination == gateway.address
+		solicited = solicited || destination == gateway.solicitedNode
+	}
+	if !onLink {
+		return false
+	}
+	if local {
+		return eth.DestinationAddress() == e.gateway.LinkAddress()
+	}
+	if (solicited && icmp.Type() == header.ICMPv6NeighborSolicit) ||
+		(destination == header.IPv6AllNodesMulticastAddress && icmp.Type() == header.ICMPv6NeighborAdvert) {
+		return eth.DestinationAddress() == header.EthernetAddressFromMulticastIPv6Address(destination)
+	}
+	return false
+}
