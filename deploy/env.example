# Copy to microcloud/.env.local (gitignored; never commit it) and fill in. deploy/deploy-cp.sh reads it.

# BoxLite: an API key of the organization the control plane's Box and every App Box run in.
BOXLITE_API_KEY=
# Which BoxLite environment (defaults: dev). REST API base, and the base the `boxlite` CLI uses.
# CP_BOXLITE_REST=https://api.dev.boxlite.ai/v1
# CP_BOXLITE_CLI_URL=https://dev.boxlite.ai/api
# The control plane's own Box (default microcloud-cp). Pick your own name for a second control plane.
# CP_BOX=microcloud-cp

# Neon (each App environment's Postgres): an API key and its organization id.
NEON_API_KEY=
NEON_ORG_ID=

# Optional: sign-in with GitHub / Google on BoxLite's own OAuth apps (for the console and for Apps
# whose owners bring no OAuth app). Callback URL to register: <control plane URL>/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional: custom domains (docs/custom-domains.md). Both, or neither.
# CUSTOM_DOMAIN_TARGET=
# CUSTOM_HOST_RESOLVER_TOKEN=
