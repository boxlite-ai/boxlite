<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>BoxLite Organization Invitation</title>
</head>
<body style="box-sizing: border-box; font-family: 'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace; font-size: 14px; line-height: 1.5; color: #13161B; margin: 0px; background-color: rgb(255, 255, 255); width: 100%; max-width: 100%;">
  <table style="box-sizing:border-box; border-spacing:0; border-collapse:collapse; width:100%!important; max-width:980px; margin-right:auto; margin-left:auto; padding:0; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important" width="100%" align="center">
    <tbody>
      <tr style="box-sizing:border-box; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important">
        <td style="box-sizing:border-box; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important; padding:16px" valign="top" align="center">
          <center style="box-sizing:border-box; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important">
            <table style="box-sizing:border-box; border-spacing:0; border-collapse:collapse; width:100%!important; max-width:100%!important; margin:0; padding:0; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important" width="100%" align="center">
              <tbody>
                <tr style="box-sizing:border-box; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important">
                  <td style="box-sizing:border-box; border-radius:0!important; display:block!important; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important; padding:0; border:1px solid #E2E5EA">
                    <table style="box-sizing:border-box; border-spacing:0; border-collapse:collapse; width:100%!important; max-width:100%!important; margin:0; padding:0; text-align:center!important; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important" align="center">
                      <tbody>
                        <tr style="box-sizing:border-box; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important">
                          <td style="box-sizing:border-box; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important; padding:32px 16px">
                            <table style="box-sizing:border-box; border-spacing:0; border-collapse:collapse; width:100%!important; max-width:100%!important; margin:0; padding:0; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important" width="100%" align="center" cellpadding="0" cellspacing="0" border="0">
                              <tbody>
                                <tr style="box-sizing:border-box; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important">
                                  <td style="box-sizing:border-box; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important; padding:0" align="center">
                                    <img style="box-sizing:border-box; display:inline-block; overflow:hidden; line-height:1; vertical-align:middle; border-radius:0; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important; border:1px solid #E2E5EA; max-width:100%; height:auto; width:72px; height:72px" alt="BoxLite logo" src="https://www.boxlite.io/brand/social-boxlite-icon-light.png" data-imagetype="External">
                                    <table style="box-sizing:border-box; border-spacing:0; border-collapse:collapse; width:100%!important; max-width:100%!important; margin:0; padding:0; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important">
                                      <tbody style="box-sizing:border-box; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important">
                                        <tr style="box-sizing:border-box; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important">
                                          <td style="font-size:20px; line-height:20px; box-sizing:border-box; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important; padding:0" height="20">&nbsp;</td>
                                        </tr>
                                      </tbody>
                                    </table>
                                    <h1 style="box-sizing:border-box; margin-top:0; margin-bottom:0; font-size:24px; font-weight:500; line-height:1.25!important; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important"><% if (invitedBy) { %><%= invitedBy %> has invited you to join the <%= organizationName %> organization<% } else { %>You have been invited to join the <%= organizationName %> organization<% } %></h1>
                                    <table style="box-sizing:border-box; border-spacing:0; border-collapse:collapse; width:100%!important; max-width:100%!important; margin:0; padding:0; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important">
                                      <tbody style="box-sizing:border-box; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important">
                                        <tr style="box-sizing:border-box; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important">
                                          <td style="font-size:32px; line-height:32px; box-sizing:border-box; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important; padding:0" height="16">&nbsp;</td>
                                        </tr>
                                      </tbody>
                                    </table>
                                    <p style="box-sizing:border-box; margin-top:0; margin-bottom:0; font-size:16px; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important">This invitation expires on <%= expiresAt %></p>
                                    <table style="box-sizing:border-box; border-spacing:0; border-collapse:collapse; width:100%!important; max-width:100%!important; margin:0; padding:0; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important">
                                      <tbody style="box-sizing:border-box; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important">
                                        <tr style="box-sizing:border-box; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important">
                                          <td style="font-size:32px; line-height:32px; box-sizing:border-box; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important; padding:0" height="20">&nbsp;</td>
                                        </tr>
                                      </tbody>
                                    </table>
                                    <table style="box-sizing:border-box; border-spacing:0; border-collapse:collapse; width:100%!important; max-width:100%!important; margin:0; padding:0; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important" width="100%" align="center" cellpadding="0" cellspacing="0" border="0">
                                      <tbody>
                                        <tr style="box-sizing:border-box; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important">
                                          <td style="box-sizing:border-box; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important; padding:0" align="center">
                                            <table style="box-sizing:border-box; border-spacing:0; border-collapse:collapse; width:100%!important; max-width:100%!important; margin:0; padding:0; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important" cellpadding="0" cellspacing="0" border="0" width="100%">
                                              <tbody>
                                                <tr style="box-sizing:border-box; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important">
                                                  <td style="box-sizing:border-box; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important; padding:0">
                                                    <table style="box-sizing:border-box; border-spacing:0; border-collapse:collapse; width:100%!important; max-width:100%!important; margin:0; padding:0; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important" width="100%" cellpadding="0" cellspacing="0" border="0">
                                                      <tbody>
                                                        <tr style="box-sizing:border-box; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important">
                                                          <td style="box-sizing:border-box; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important; padding:0" align="center"><a style="background-color:#13161B!important; box-sizing:border-box; color:#FFFFFF; text-decoration:none; display:inline-block; font-size:16px; font-weight:500; line-height:1.5; white-space:nowrap; vertical-align:middle; border-radius:0; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important; padding:10px 12px; margin:0; border:1px solid #13161B" href="<%= invitationLink %>">Join <%= organizationName %></a> </td>
                                                        </tr>
                                                      </tbody>
                                                    </table>
                                                  </td>
                                                </tr>
                                              </tbody>
                                            </table>
                                          </td>
                                        </tr>
                                      </tbody>
                                    </table>
                                    <table style="box-sizing:border-box; border-spacing:0; border-collapse:collapse; width:100%!important; max-width:100%!important; margin:0; padding:0; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important">
                                      <tbody style="box-sizing:border-box; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important">
                                        <tr style="box-sizing:border-box; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important">
                                          <td style="font-size:32px; line-height:32px; box-sizing:border-box; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important; padding:0" height="16">&nbsp;</td>
                                        </tr>
                                      </tbody>
                                    </table>
                                    <p style="box-sizing:border-box; margin-top:0; margin-bottom:0; font-size:16px; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important">Button not working? Paste the following link into your browser:<br style="box-sizing:border-box; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important"><a style="background-color:transparent; box-sizing:border-box; color:#13161B; text-decoration:underline; text-underline-offset:2px; word-break: break-all; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important" href="<%= invitationLink %>"><%= invitationLink %></a> </p>
                                  </td>
                                </tr>
                              </tbody>
                            </table>
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  </td>
                </tr>
              </tbody>
            </table>
            <table style="box-sizing:border-box; border-spacing:0; border-collapse:collapse; width:100%!important; max-width:100%!important; margin:0; padding:0; text-align:center!important; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important" width="100%" align="center" cellpadding="0" cellspacing="0" border="0">
              <tbody>
                <tr style="box-sizing:border-box; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important">
                  <td style="box-sizing:border-box; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important; padding:0" align="center">
                    <table style="box-sizing:border-box; border-spacing:0; border-collapse:collapse; width:100%!important; max-width:100%!important; margin:0; padding:0; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important">
                      <tbody style="box-sizing:border-box; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important">
                        <tr style="box-sizing:border-box; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important">
                          <td style="font-size:16px; line-height:16px; box-sizing:border-box; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important; padding:0" height="8">&nbsp;</td>
                        </tr>
                      </tbody>
                    </table>
                    <p style="box-sizing:border-box; margin-top:0; margin-bottom:0; font-size:12px!important; color:#6B7079; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important">* If you were not expecting this invitation, please disregard this email.</p>
                    <table style="box-sizing:border-box; border-spacing:0; border-collapse:collapse; width:100%!important; max-width:100%!important; margin:0; padding:0; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important">
                      <tbody style="box-sizing:border-box; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important">
                        <tr style="box-sizing:border-box; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important">
                          <td style="font-size:16px; line-height:16px; box-sizing:border-box; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important; padding:0" height="16">&nbsp;</td>
                        </tr>
                      </tbody>
                    </table>
                    <p style="box-sizing:border-box; margin-top:0; margin-bottom:0; color:#6B7079; font-size:12px!important; font-family:'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace!important">Copyright © <%= new Date().getFullYear() %> BoxLite AI. All Rights Reserved</p>
                  </td>
                </tr>
              </tbody>
            </table>
          </center>
        </td>
      </tr>
    </tbody>
  </table>
  <div style="display: none; white-space: nowrap; box-sizing: border-box; font: 15px / 0 'IBM Plex Mono',ui-monospace,'SFMono-Regular','SF Mono',monospace;">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; </div>
</body>
</html>
