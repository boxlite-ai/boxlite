{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "moduleResolution": "node10",
    "paths": {
      "@boxlite-ai/api-client": ["libs/api-client/src/index.ts"],
      "@boxlite-ai/runner-api-client": ["libs/runner-api-client/src/index.ts"],
      "@boxlite-ai/analytics-api-client": ["libs/analytics-api-client/src/index.ts"],
      "@boxlite-ai/ci-listener": ["libs/ci-listener/src/index.ts"],
      "@boxlite-ai/ci-listener/sqlite": ["libs/ci-listener/src/state/sqlite.ts"],
      "@boxlite-ai/ci-listener/testing": ["libs/ci-listener/tests/capacity.ts"],
      "@visulima/disposable-email-domains/edge": ["node_modules/@visulima/disposable-email-domains/dist/edge.d.ts"]
    },
    "resolveJsonModule": true,
    "types": ["jest", "node"]
  },
  "include": ["src/**/*.test.ts", "src/**/*.spec.ts", "src/**/*.d.ts"]
}
