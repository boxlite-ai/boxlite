[Unit]
Description=BoxLite Cloud platform guard
AssertPathIsMountPoint=/sys/fs/bpf
RequiresMountsFor=/etc/boxlite/platform-guard /sys/fs/bpf

[Service]
Type=simple
ExecStart=/usr/local/bin/boxlite-platform-guard
RuntimeDirectory=boxlite-platform-guard
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
Restart=on-failure
RestartSec=250ms

[Install]
WantedBy=multi-user.target
