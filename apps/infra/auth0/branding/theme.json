{
  "_comment": [
    "Auth0 Universal Login theme mapped from apps/dashboard/src/index.css.",
    "Apply with npm run auth0:universal-login -- apply --stage <name>.",
    "Keys beginning with _ are stripped before the Management API call.",
    "Asset paths are resolved only from the selected target's stackOrigin.",
    "This is the complete Auth0 Free-plan contract: page-template geometry is paid-only."
  ],

  "displayName": "boxlite-console",

  "colors": {
    "widget_background": "#1A1D24",
    "widget_border": "#2A2F3A",
    "header": "#FFFFFF",
    "body_text": "#FFFFFF",
    "input_labels_placeholders": "#8C919C",
    "icons": "#8C919C",
    "input_background": "#13161B",
    "input_border": "#2A2F3A",
    "input_filled_text": "#FFFFFF",
    "primary_button": "#FFFFFF",
    "primary_button_label": "#13161B",
    "secondary_button_border": "#2A2F3A",
    "secondary_button_label": "#FFFFFF",
    "links_focused_components": "#00B0F0",
    "base_focus_color": "#00B0F0",
    "base_hover_color": "#232833",
    "error": "#E05548",
    "success": "#5AD67D",
    "read_only_background": "#232833",
    "captcha_widget_theme": "dark"
  },

  "borders": {
    "buttons_style": "sharp",
    "inputs_style": "sharp",
    "button_border_radius": 1,
    "input_border_radius": 1,
    "widget_corner_radius": 1,
    "button_border_weight": 1,
    "input_border_weight": 1,
    "widget_border_weight": 1,
    "show_widget_shadow": false
  },

  "fonts": {
    "font_url": "/auth0/ibm-plex-mono-400-ba204497.woff2",
    "reference_text_size": 13,
    "title": { "bold": false, "size": 123 },
    "subtitle": { "bold": false, "size": 92 },
    "body_text": { "bold": false, "size": 100 },
    "buttons_text": { "bold": false, "size": 100 },
    "input_labels": { "bold": false, "size": 100 },
    "links": { "bold": false, "size": 100 },
    "links_style": "normal"
  },

  "page_background": {
    "background_color": "#13161B",
    "background_image_url": "",
    "page_layout": "center"
  },

  "widget": {
    "header_text_alignment": "center",
    "logo_position": "center",
    "logo_height": 36,
    "logo_url": "/auth0/boxlite-light-ec0b1243.png",
    "social_buttons_layout": "top"
  }
}
