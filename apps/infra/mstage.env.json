{
  "app": "boxlite-app",
  "appShort": "bl-app",
  "root": "../..",
  "artifacts": {
    "api": {
      "dockerfile": "apps/api/Dockerfile",
      "context": "."
    },
    "proxy": {
      "dockerfile": "apps/proxy/Dockerfile",
      "context": "."
    },
    "otel-collector": {
      "dockerfile": "apps/otel-collector/Dockerfile",
      "context": "."
    },
    "registry-proxy": {
      "dockerfile": "apps/image-service/Dockerfile",
      "context": "."
    }
  },
  "audit": {
    "directory": "apps",
    "manager": "yarn"
  },
  "env": {
    "selectGroup": {
      "deploy": {
        "required": [
          "STACK_DOMAIN",
          "PROXY_DOMAIN",
          "OIDC_ISSUER_BASE_URL",
          "CLOUDFLARE_API_TOKEN",
          "CLOUDFLARE_DEFAULT_ACCOUNT_ID",
          "CLOUDFLARE_ZONE_ID",
          "BOXLITE_STAGE_CONFIG_DIGEST"
        ],
        "optional": [
          "IAM_PERMISSIONS_BOUNDARY_STAGE",
          "PROXY_PROTOCOL",
          "PROXY_TEMPLATE_URL",
          "DASHBOARD_DOMAIN",
          "STACK_USER_DOMAIN",
          "CLOUDFLARE_USER_ZONE_ID",
          "DASHBOARD_URL",
          "DASHBOARD_BASE_API_URL",
          "APP_URL",
          "MAIL_DOMAIN",
          "MAIL_RELAY_HOST",
          "MCP_RESOURCE_URL",
          "OIDC_AUDIENCE",
          "OIDC_END_SESSION_ENDPOINT",
          "OIDC_POST_LOGOUT_REDIRECT_ALLOWLIST",
          "OIDC_MANAGEMENT_API_ENABLED",
          "OIDC_MANAGEMENT_API_AUDIENCE",
          "OIDC_MANAGEMENT_API_BASE_URL",
          "OIDC_MANAGEMENT_API_TOKEN_URL",
          "PUBLIC_OIDC_DOMAIN",
          "RUNNERS",
          "RUNNER_PORT",
          "DEFAULT_RUNNER_NAME",
          "DEFAULT_REGION_ID",
          "DEFAULT_TEMPLATE",
          "CLICKHOUSE_MODE",
          "CLICKHOUSE_RETENTION_HOURS",
          "CLICKHOUSE_URL",
          "CLICKHOUSE_WRITER_PASSWORD_SECRET_ARN",
          "CLICKHOUSE_READER_PASSWORD_SECRET_ARN",
          "OTEL_OPENAPI_ENABLED",
          "CLICKSTACK_CONSUMER_ACCOUNT",
          "BOX_OTEL_ENDPOINT_URL",
          "BOX_MIGRATION_ARCHIVE_PREFIX",
          "BOXLITE_IMAGE_COLD_PULL_LIMIT",
          "BOXLITE_IMAGE_COLD_PULL_WINDOW_SECONDS",
          "BOXLITE_IMAGE_REGISTRY_ALLOWLIST",
          "BOXLITE_SYSTEM_BASE_IMAGE",
          "BOXLITE_SYSTEM_IMAGES",
          "BOXLITE_SYSTEM_IMAGE_TAG",
          "BOXLITE_SYSTEM_NODE_IMAGE",
          "BOXLITE_SYSTEM_PYTHON_IMAGE",
          "BOXLITE_SYSTEM_SOURCE_REGISTRY_NAME",
          "BOXLITE_SYSTEM_SOURCE_REGISTRY_PROJECT_ID",
          "BOXLITE_SYSTEM_SOURCE_REGISTRY_URL",
          "BOXLITE_SYSTEM_SOURCE_REGISTRY_USERNAME",
          "BILLING_API_URL",
          "USAGE_EXPORT_URL",
          "SVIX_SERVER_URL",
          "POSTHOG_HOST",
          "INCIDENT_IO_ALERT_SOURCE_CONFIG_ID",
          "INCIDENT_IO_HEARTBEAT_ID",
          "STATUS_SYNC_DEDUP_PREFIX"
        ]
      },
      "pulumi": ["PULUMI_CONFIG_PASSPHRASE"],
      "api": {
        "required": [
          "ADMIN_API_KEY",
          "ENCRYPTION_KEY",
          "ENCRYPTION_SALT",
          "OIDC_CLIENT_ID",
          "OTEL_COLLECTOR_API_KEY",
          "PROXY_API_KEY"
        ],
        "optional": [
          "OIDC_MANAGEMENT_API_CLIENT_ID",
          "OIDC_MANAGEMENT_API_CLIENT_SECRET",
          "OIDC_ACCOUNT_LINK_SECRET",
          "POSTHOG_API_KEY",
          "SVIX_AUTH_TOKEN",
          "INCIDENT_IO_TOKEN",
          "USAGE_EXPORT_TOKEN",
          "SMTP_USER",
          "SMTP_PASSWORD",
          "ORGANIZATION_INVITATION_TTL_SECONDS",
          "PLATFORM_SUBDOMAIN_MIN_LENGTH",
        "CHECKPOINTS_ENABLED",
        "FILESTORE_INSTANCES",
          "BOXLITE_SYSTEM_SOURCE_REGISTRY_PASSWORD",
          "GHCR_USERNAME",
          "GHCR_TOKEN",
          "OTEL_ENABLED",
          "TURNSTILE_SITEKEY",
          "TURNSTILE_SECRET_KEY",
          "TURNSTILE_EXPECTED_HOSTNAMES",
          "TURNSTILE_TIMEOUT_MS",
          "CI_GITHUB_APP_CLIENT_ID",
          "CI_GITHUB_APP_CLIENT_SECRET",
          "CI_GITHUB_OAUTH_CLIENT_ID",
          "CI_GITHUB_OAUTH_CLIENT_SECRET",
          "CI_GITHUB_ORG_APP_CLIENT_ID",
          "CI_GITHUB_ORG_APP_SLUG",
          "CI_GITHUB_ORG_APP_PRIVATE_KEY",
          "CI_GITHUB_ORG_APP_CLIENT_SECRET",
          "CI_GITHUB_ORG_WEBHOOK_SECRET",
          "CI_GITHUB_APP_SLUG",
          "CI_GITHUB_APP_PRIVATE_KEY",
          "CI_GITHUB_WEBHOOK_SECRET",
          "CI_SECRET_ENCRYPTION_KEY",
          "CI_WORKER_IMAGE",
          "CI_WORKER_GROUP_NAME",
          "CI_WORKER_CPUS",
          "CI_WORKER_MEMORY_GB"
        ]
      },
      "proxy": {
        "required": ["PROXY_API_KEY"],
        "optional": ["OTEL_LOGGING_ENABLED", "OTEL_TRACING_ENABLED"]
      },
      "otel-collector": ["OTEL_COLLECTOR_API_KEY"],
      "runner": {
        "optional": ["BOXLITE_RUNNER_ENV", "OTEL_LOGGING_ENABLED", "OTEL_TRACING_ENABLED"]
      },
      "secret": {
        "optional": [
          "TURNSTILE_SECRET_KEY",
          "CI_GITHUB_APP_PRIVATE_KEY",
          "CI_GITHUB_WEBHOOK_SECRET",
          "CI_SECRET_ENCRYPTION_KEY",
          "CI_GITHUB_APP_CLIENT_SECRET",
          "CI_GITHUB_OAUTH_CLIENT_SECRET",
          "CI_GITHUB_ORG_APP_PRIVATE_KEY",
          "CI_GITHUB_ORG_APP_CLIENT_SECRET",
          "CI_GITHUB_ORG_WEBHOOK_SECRET"
        ]
      }
    },
    "digest": {
      "key": "BOXLITE_STAGE_CONFIG_DIGEST",
      "group": "deploy"
    }
  }
}
