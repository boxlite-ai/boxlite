{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RegistryLogin",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "StageRepository",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "ecr:CompleteLayerUpload",
        "ecr:CreateRepository",
        "ecr:DescribeImageScanFindings",
        "ecr:DescribeImages",
        "ecr:DescribeRepositories",
        "ecr:InitiateLayerUpload",
        "ecr:PutImage",
        "ecr:UploadLayerPart"
      ],
      "Resource": "arn:aws:ecr:<REGION>:<ACCOUNT>:repository/<ECR_REPOSITORY>"
    },
    {
      "Sid": "CreateCloudMapPrivateZone",
      "Effect": "Allow",
      "Action": [
        "route53:CreateHostedZone",
        "route53:ListHostedZonesByName"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadCloudMapPrivateZone",
      "Effect": "Allow",
      "Action": "route53:GetHostedZone",
      "Resource": "arn:aws:route53:::hostedzone/*"
    },
    {
      "Sid": "BoxLiteAwsControlPlane",
      "Effect": "Allow",
      "Action": [
        "acm:*",
        "application-autoscaling:*",
        "autoscaling:*",
        "cloudfront:*",
        "cloudfront-keyvaluestore:*",
        "cloudwatch:*",
        "ec2:*",
        "ecs:*",
        "elasticache:*",
        "elasticloadbalancing:*",
        "kms:DescribeKey",
        "logs:*",
        "rds:*",
        "secretsmanager:ListSecrets",
        "secretsmanager:GetRandomPassword",
        "servicediscovery:*",
        "tag:GetResources",
        "tag:GetTagKeys",
        "tag:GetTagValues"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SecretsForThisStage",
      "Effect": "Allow",
      "Action": "secretsmanager:*",
      "Resource": [
        "arn:aws:secretsmanager:<REGION>:<ACCOUNT>:secret:boxlite/workloads/<APP>/<STAGE>/*",
        "arn:aws:secretsmanager:<REGION>:<ACCOUNT>:secret:registry-credential-<APP>_<STAGE>_-*"
      ]
    },
    {
      "Sid": "NativeStateBucketRead",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketVersions",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::<STATE_BUCKET>"
      ]
    },
    {
      "Sid": "NativeState",
      "Effect": "Allow",
      "Action": [
        "s3:AbortMultipartUpload",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::<STATE_BUCKET>/.pulumi/meta.yaml",
        "arn:aws:s3:::<STATE_BUCKET>/.pulumi/stacks/<APP>/<STAGE>.json*",
        "arn:aws:s3:::<STATE_BUCKET>/.pulumi/history/<APP>/<STAGE>/*",
        "arn:aws:s3:::<STATE_BUCKET>/.pulumi/backups/<APP>/<STAGE>/*",
        "arn:aws:s3:::<STATE_BUCKET>/.pulumi/locks/organization/<APP>/<STAGE>/*",
        "arn:aws:s3:::<STATE_BUCKET>/secret/<APP>/<STAGE>.json"
      ]
    },
    {
      "Sid": "RunnerRollout",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::<STATE_BUCKET>/rollouts/aws/<APP>/<STAGE>/<REGION>/i-*.json"
      ]
    },
    {
      "Sid": "BoxLiteStageBuckets",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::<ARTIFACT_BUCKET>",
        "arn:aws:s3:::<ARTIFACT_BUCKET>/*",
        "arn:aws:s3:::<STORAGE_BUCKET>",
        "arn:aws:s3:::<STORAGE_BUCKET>/*",
        "arn:aws:s3:::<CHECKPOINT_BUCKET>",
        "arn:aws:s3:::<CHECKPOINT_BUCKET>/*"
      ]
    },
    {
      "Sid": "ReadRegionalBootstrap",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters"
      ],
      "Resource": [
        "arn:aws:ssm:<REGION>:<ACCOUNT>:parameter/boxlite/pulumi/bootstrap"
      ]
    },
    {
      "Sid": "StageParameters",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:PutParameter",
        "ssm:DeleteParameter",
        "ssm:AddTagsToResource",
        "ssm:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:ssm:<REGION>:<ACCOUNT>:parameter/boxlite/pulumi/passphrase/<APP>/<STAGE>",
        "arn:aws:ssm:<REGION>:<ACCOUNT>:parameter/boxlite/workloads/<APP>/<STAGE>/*"
      ]
    },
    {
      "Sid": "BoxLiteMailIdentity",
      "Effect": "Allow",
      "Action": [
        "ses:CreateEmailIdentity",
        "ses:DeleteEmailIdentity",
        "ses:GetEmailIdentity",
        "ses:PutEmailIdentityConfigurationSetAttributes",
        "ses:PutEmailIdentityDkimSigningAttributes",
        "ses:CreateConfigurationSet",
        "ses:DeleteConfigurationSet",
        "ses:GetConfigurationSet",
        "ses:PutConfigurationSetDeliveryOptions",
        "ses:PutConfigurationSetReputationOptions",
        "ses:PutConfigurationSetSendingOptions",
        "ses:PutConfigurationSetSuppressionOptions",
        "ses:PutConfigurationSetTrackingOptions",
        "ses:PutConfigurationSetVdmOptions",
        "ses:ListTagsForResource",
        "ses:TagResource",
        "ses:UntagResource"
      ],
      "Resource": [
        "arn:aws:ses:<REGION>:<ACCOUNT>:identity/*",
        "arn:aws:ses:<REGION>:<ACCOUNT>:configuration-set/boxlite-<STAGE>-*",
        "arn:aws:ses:<REGION>:<ACCOUNT>:configuration-set/<APP>-<STAGE>-*"
      ]
    },
    {
      "Sid": "ReadMailIdentityVerification",
      "Effect": "Allow",
      "Action": [
        "ses:GetIdentityVerificationAttributes"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RunnerCommandChannel",
      "Effect": "Allow",
      "Action": [
        "ssm:SendCommand"
      ],
      "Resource": [
        "arn:aws:ec2:<REGION>:<ACCOUNT>:instance/*",
        "arn:aws:ssm:<REGION>::document/AWS-RunShellScript"
      ]
    },
    {
      "Sid": "RunnerCommandStatus",
      "Effect": "Allow",
      "Action": [
        "ssm:DescribeInstanceInformation",
        "ssm:GetCommandInvocation",
        "ssm:ListCommandInvocations",
        "ssm:ListCommands",
        "ssm:DescribeParameters"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadIamAndAccountMetadata",
      "Effect": "Allow",
      "Action": [
        "iam:GetInstanceProfile",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole",
        "iam:ListPolicyVersions",
        "iam:ListRolePolicies",
        "iam:ListRoleTags",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CreateBoundedBoxLiteRoles",
      "Effect": "Allow",
      "Action": "iam:CreateRole",
      "Resource": [
        "arn:aws:iam::<ACCOUNT>:role/<APP>-<STAGE>-*",
        "arn:aws:iam::<ACCOUNT>:role/boxlite-<STAGE>-*"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::<ACCOUNT>:policy/<APP>-<STAGE>-runtime-boundary"
        }
      }
    },
    {
      "Sid": "DenySelfPrivilegeEscalation",
      "Effect": "Deny",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DeleteRole",
        "iam:DeleteRolePermissionsBoundary",
        "iam:DeleteRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PutRolePermissionsBoundary",
        "iam:PutRolePolicy",
        "iam:UpdateAssumeRolePolicy",
        "iam:UpdateRole",
        "iam:UpdateRoleDescription",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicy",
        "iam:DeletePolicyVersion",
        "iam:SetDefaultPolicyVersion",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:RemoveRoleFromInstanceProfile"
      ],
      "Resource": [
        "arn:aws:iam::<ACCOUNT>:role/boxlite-*-github-deploy",
        "arn:aws:iam::<ACCOUNT>:policy/boxlite-*-runtime-boundary",
        "arn:aws:iam::<ACCOUNT>:role/<APP>-*-pulumi-deploy",
        "arn:aws:iam::<ACCOUNT>:policy/<APP>-*-runtime-boundary"
      ]
    },
    {
      "Sid": "ManageBoxLiteRoles",
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:CreateInstanceProfile",
        "iam:DeleteInstanceProfile",
        "iam:DeleteRole",
        "iam:DeleteRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PassRole",
        "iam:PutRolePolicy",
        "iam:RemoveRoleFromInstanceProfile",
        "iam:AddRoleToInstanceProfile",
        "iam:TagInstanceProfile",
        "iam:TagRole",
        "iam:UntagInstanceProfile",
        "iam:UntagRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:UpdateRole",
        "iam:UpdateRoleDescription"
      ],
      "Resource": [
        "arn:aws:iam::<ACCOUNT>:role/<APP>-<STAGE>-*",
        "arn:aws:iam::<ACCOUNT>:instance-profile/<APP>-<STAGE>-*",
        "arn:aws:iam::<ACCOUNT>:role/boxlite-<STAGE>-*",
        "arn:aws:iam::<ACCOUNT>:instance-profile/boxlite-<STAGE>-*"
      ]
    },
    {
      "Sid": "SetBoxLiteRoleBoundary",
      "Effect": "Allow",
      "Action": "iam:PutRolePermissionsBoundary",
      "Resource": [
        "arn:aws:iam::<ACCOUNT>:role/<APP>-<STAGE>-*",
        "arn:aws:iam::<ACCOUNT>:role/boxlite-<STAGE>-*"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::<ACCOUNT>:policy/<APP>-<STAGE>-runtime-boundary"
        }
      }
    },
    {
      "Sid": "ManageBoxLitePolicies",
      "Effect": "Allow",
      "Action": [
        "iam:CreatePolicy",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicy",
        "iam:DeletePolicyVersion",
        "iam:SetDefaultPolicyVersion",
        "iam:TagPolicy",
        "iam:UntagPolicy"
      ],
      "Resource": [
        "arn:aws:iam::<ACCOUNT>:policy/<APP>-<STAGE>-*",
        "arn:aws:iam::<ACCOUNT>:policy/boxlite-<STAGE>-*"
      ]
    },
    {
      "Sid": "CreateRequiredServiceLinkedRoles",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::*:role/aws-service-role/*",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": [
            "autoscaling.amazonaws.com",
            "elasticache.amazonaws.com",
            "ecs.amazonaws.com",
            "ecs.application-autoscaling.amazonaws.com",
            "elasticloadbalancing.amazonaws.com",
            "rds.amazonaws.com"
          ]
        }
      }
    }
  ]
}
